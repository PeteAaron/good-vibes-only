# good-vibes-only :: .editorconfig
# Keeps whitespace, line endings, and charset consistent across editors so
# Biome's formatter doesn't fight your IDE on save.
# https://editorconfig.org

root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false
